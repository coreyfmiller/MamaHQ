# Mama HQ — environment template. Copy to .env.local and fill in real values.
# .env.local is gitignored and must NEVER be committed.

# OpenAI (server-side only). Powers the Inbox: extracts proposed actions from free text.
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Supabase — persistence. Create a project at https://supabase.com/dashboard,
# then Project Settings -> API for these values.
# URL and anon key are safe to expose (RLS protects data). service_role is SERVER-ONLY.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
