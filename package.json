{
  "name": "mama-hq",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "catalog:validate": "node lib/grocery/catalog/validate.ts",
    "catalog:seed": "node scripts/seed-catalog.ts",
    "test:grocery-search": "node scripts/test-grocery-search.ts",
    "bench:grocery-search": "node scripts/bench-grocery-search.ts",
    "test:grocery-resolver": "node scripts/test-grocery-resolver.ts",
    "test:grocery-actions": "node scripts/test-grocery-actions.ts",
    "test:db": "node scripts/test-db-completion.ts",
    "test:security": "node scripts/test-security.ts",
    "test:household": "node scripts/test-household.ts",
    "test:membership": "node scripts/test-membership.ts",
    "test:tasks": "node scripts/test-tasks.ts",
    "test:handoff": "node scripts/test-handoff.ts",
    "test:db-all": "node scripts/test-db-completion.ts && node scripts/test-security.ts && node scripts/test-household.ts && node scripts/test-membership.ts && node scripts/test-tasks.ts && node scripts/test-handoff.ts",
    "db:reset": "supabase db reset",
    "db:verify": "node scripts/db/run-db-tests.ts",
    "verify": "npm run catalog:validate && npm run test:grocery-search && npm run test:grocery-resolver && npm run test:grocery-actions && npm run typecheck && npm run lint",
    "verify:all": "npm run verify && npm run db:verify"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "16.3.3",
    "openai": "^7.15.0",
    "react": "^19",
    "react-dom": "^19",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.3.1",
    "tesseract.js": "7.0.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3"
  }
}
